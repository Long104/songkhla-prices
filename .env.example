# Local development: use the Docker Postgres from docker-compose.yml
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/songkhla_prices
#
# Production (Vercel): Neon serverless Postgres connection string
# Get yours at https://console.neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/songkhla-prices?sslmode=require

# Secret protecting POST /api/cron/scrape.
# Vercel sets CRON_SECRET automatically for cron-triggered requests; you must
# set the same value manually for local testing.
CRON_SECRET=replace-with-a-long-random-string